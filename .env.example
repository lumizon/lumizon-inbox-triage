# No API key needed:
#  - triage runs on a local d3 decision model (start it with `npm run classifier`)
#  - reply drafts run through Claude Code headless (`claude -p`), signed in with your Claude account

# Triage backend: d3 (local, default) or claude
TRIAGE=d3
# d3 size: vllm-sr/d3-nano (2.2B, default) or vllm-sr/d3-mini (4.5B). Read by the classifier service.
# D3_MODEL=vllm-sr/d3-nano
# D3_REVISION=<commit hash you reviewed>
# D3_URL=http://127.0.0.1:4401

# Claude Code model for drafts, e.g. sonnet or opus. Unset = your Claude Code default.
# CLAUDE_MODEL=

# PORT=4400

# Email source: "mock" (synthetic emails in data/emails.json) or "gmail"
SOURCE=mock

# Gmail (only when SOURCE=gmail). Create an OAuth "Desktop app" client in Google Cloud,
# enable the Gmail API, then run `npm run gmail:auth`.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_QUERY=in:inbox is:unread -label:ai-triaged
# true = approving a ticket sends the reply. false (default) = it is saved as a Gmail draft.
# GMAIL_SEND=false
