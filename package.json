{
  "name": "lumizon-inbox-triage",
  "version": "1.0.0",
  "private": true,
  "description": "AI support inbox triage: a local d3 model tags, code finds the order, Claude drafts a reply, a human approves.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "eval": "tsx --env-file-if-exists=.env src/eval.ts",
    "seed:orders": "tsx scripts/make-orders.ts",
    "gmail:auth": "tsx --env-file-if-exists=.env scripts/gmail-auth.ts",
    "gmail:seed": "tsx --env-file-if-exists=.env scripts/gmail-seed.ts",
    "typecheck": "tsc --noEmit",
    "classifier": "cd classifier && uv run python server.py",
    "eval:triage": "tsx --env-file-if-exists=.env src/eval.ts --triage-only",
    "compare:drafts": "tsx --env-file-if-exists=.env scripts/compare-drafts.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
